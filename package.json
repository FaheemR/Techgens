{
  "name": "techgens",
  "version": "0.1.0",
  "private": true,
  "description": "Techgens — an AI-staffed product company, orchestrated on GitHub Copilot",
  "type": "module",
  "packageManager": "pnpm@12.16.1",
  "engines": {
    "node": ">=22.12.0"
  },
  "scripts": {
    "dev": "pnpm --parallel --filter @techgens/orchestrator --filter @techgens/web dev",
    "build": "pnpm -r --if-present run build",
    "typecheck": "pnpm -r --if-present run typecheck",
    "test": "vitest run",
    "test:watch": "vitest",
    "db:generate": "pnpm --filter @techgens/db run generate",
    "db:migrate": "pnpm --filter @techgens/orchestrator run migrate",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "check": "pnpm run typecheck && pnpm run test"
  },
  "devDependencies": {
    "@types/node": "^24.0.0",
    "prettier": "^3.6.0",
    "typescript": "6.0.3",
    "vitest": "^5.1.0"
  }
}
