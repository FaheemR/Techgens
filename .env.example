# Copy to .env and adjust. Never commit .env.

# "copilot" (default) uses your GitHub Copilot subscription through the Copilot SDK.
# "fake" runs demo mode: scripted agents + an in-memory GitHub, no AI credits spent.
AGENT_RUNTIME=copilot

# Optional: fine-grained personal access token (owned by your user, with the "Copilot Requests" account permission
# plus repository permissions for the product repos). You can also paste it in Settings instead.
GITHUB_TOKEN_BOOTSTRAP=

# 64 hex chars used to encrypt stored tokens. Generated into the data volume when empty.
#   openssl rand -hex 32
TECHGENS_SECRET_KEY=

# URLs as seen by your browser (GitHub OAuth callbacks use the orchestrator URL).
TECHGENS_PUBLIC_URL=http://localhost:4000
TECHGENS_WEB_URL=http://localhost:3000

# Optional external Copilot runtime (docker compose --profile external-runtime):
# COPILOT_RUNTIME_URL=copilot-runtime:4321
# COPILOT_CONNECTION_TOKEN=<openssl rand -hex 32>
# COPILOT_GITHUB_TOKEN=<same token as above>

LOG_LEVEL=info
