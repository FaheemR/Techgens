# Copy to .env and adjust. Never commit .env.

# "copilot" (default) uses your GitHub Copilot subscription through the Copilot SDK.
# "fake" runs demo mode: scripted agents + a simulated GitHub, no AI credits spent — use it for your first look.
AGENT_RUNTIME=copilot

# Optional: fine-grained personal access token (owned by your user, with the "Copilot Requests" account permission
# plus repository permissions for the product repos). You can also paste it in Settings instead.
GITHUB_TOKEN_BOOTSTRAP=

# 64 hex chars used to encrypt stored tokens. Generated into the data volume when empty.
#   openssl rand -hex 32
TECHGENS_SECRET_KEY=

# Address of Techgens as seen by your browser (used for GitHub App callbacks; the web app proxies /api/*).
TECHGENS_PUBLIC_URL=http://localhost:3000
TECHGENS_WEB_URL=http://localhost:3000

# Optional external Copilot runtime (docker compose --profile external-runtime):
# COPILOT_RUNTIME_URL=copilot-runtime:4321
# COPILOT_CONNECTION_TOKEN=<openssl rand -hex 32>
# COPILOT_GITHUB_TOKEN=<same token as above>

LOG_LEVEL=info

# Prebuilt images used by `docker compose pull` (change the prefix if you publish your own, e.g. from a fork).
# TECHGENS_IMAGE_PREFIX=ghcr.io/faheemr/techgens
# TECHGENS_TAG=latest

# Only for `docker compose up --build` on networks that block the public npm registry: your organisation's
# npm mirror (Artifactory, Azure Artifacts, Nexus…). Private CA certificates go in docker/certs/*.crt.
# NPM_REGISTRY=https://npm.example.corp/
